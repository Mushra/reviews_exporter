  {
    "id": "critic-pc-gamer-19",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "PC Gamer",
    "date": "2019-11-15",
    "score": 88,
    "text": "Red Dead Redemption 2's stark, slow depiction of America's fading frontier is a monumental work straining against stubborn mission design and stability problems.",
