  {
    "id": "critic-xgn-20",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "XGN",
    "date": "2019-11-15",
    "score": 90,
    "text": "Red Dead Redemption 2 on PC is everything that the console version was but better, although with some caveats. The controls are improved with mouse and keyboard, but are still a bit clunky. The graphics are breathtaking, but it does requires a beefy PC and there are some technical problems. If you can run it however, it's one of the best games the platform has to offer.",
    "source": {
      "external_url": "https://www.xgn.nl/review/red-dead-redemption-2-pc-review"
    },
