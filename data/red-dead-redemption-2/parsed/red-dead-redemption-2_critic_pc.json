        "score": 93
      }
    }
  },
  {
    "id": "critic-god-is-a-geek-12",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "God is a Geek",
    "date": "2019-11-25",
    "score": 100,
    "text": "Once upon a time people would overuse the word “epic”, but it’s a phrase truly befitting of Rockstar’s brilliant Red Dead Redemption 2.",
