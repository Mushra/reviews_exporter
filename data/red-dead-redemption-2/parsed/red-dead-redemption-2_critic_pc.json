  {
    "id": "critic-softpedia-13",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "Softpedia",
    "date": "2019-11-25",
    "score": 90,
    "text": "I'm quite sure that Red Dead Redemption 2 doesn't redefine the open-world genre, but it surely brings it to a much higher level. And it's not just through sheer size that it does that, but by combining writing, visuals, music, voice acting, and gameplay mechanics to deliver an engrossing experience that sometimes is better than the one in the real world.",
    "source": {
      "external_url": "https://www.softpedia.com/reviews/games/pc/red-dead-redemption-review-528292.shtml"
    },
    "metadata": {
      "product_id": 1400579386,
      "product_title": "Red Dead Redemption 2",
      "publication_slug": "softpedia",
      "critic_score_summary": {
        "url": "/game/red-dead-redemption-2/critic-reviews/?platform=pc",
        "score": 93
      }
    }
  },
  {
    "id": "critic-the-digital-fix-14",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "The Digital Fix",
    "date": "2019-11-25",
    "score": 100,
    "text": "Red Dead Redemption 2 is a masterpiece. No other game has ever tried and succeeded to capture a sense of a time and place long gone while also blending social commentary so well. The addition of a multiplayer mode that's a real step up from Rockstar's last effort makes Red Dead Redemption 2 unmissable on PC.",
    "source": {
      "external_url": "https://www.thedigitalfix.com/gaming/content/23989/red-dead-redemption-2-pc/"
    },
    "metadata": {
      "product_id": 1400579386,
