  {
    "id": "critic-gaming-age-4",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "Gaming Age",
    "date": "2019-12-12",
    "score": 91,
    "text": "Red Dead Redemption 2 is one of the greatest games of this generation, and this PC port is no different after a solid month of stumbles and patches. I am excited to see what the future of Red Dead Online holds, and excited to see how people continue to interact with this game in the future.",
