  {
    "id": "critic-digital-chumps-16",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "Digital Chumps",
    "date": "2019-11-21",
    "score": 95,
    "text": "Red Dead Redemption 2 on the PC is the top-tier version of the game. It’s the Woodford Reserve bourbon when you’re used to drinking Kentucky Gentleman. It will most undoubtedly look better than the console version and include all the gameplay that you would expect from the title, but the cost of getting it to that Woodford Reserve level is definitely a price only a PC elitist would understand and accept.",
    "source": {
      "external_url": "http://digitalchumps.com/red-dead-redemption-2-pc/"
    },
    "metadata": {
      "product_id": 1400579386,
      "product_title": "Red Dead Redemption 2",
