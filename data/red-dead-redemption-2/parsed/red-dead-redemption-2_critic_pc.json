  {
    "id": "critic-game-revolution-2",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "Game Revolution",
    "date": "2019-12-17",
    "score": 100,
    "text": "My biggest warning to anyone considering purchasing RDR2 on PC is that you need to have patience when you set it up. Take the time to go through each graphics option, compare your performance on Vulkan vs. DirectX 12, and tailor the game to your specs. Once you have the game tuned, there’s no better way to experience it than on PC.",
    "source": {
      "external_url": "https://www.gamerevolution.com/review/624227-red-dead-redemption-2-pc-review"
    },
    "metadata": {
      "product_id": 1400579386,
      "product_title": "Red Dead Redemption 2",
      "publication_slug": "game-revolution",
      "critic_score_summary": {
