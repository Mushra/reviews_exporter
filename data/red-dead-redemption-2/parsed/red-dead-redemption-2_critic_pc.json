    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "Impulsegamer",
    "date": "2019-11-19",
    "score": 100,
    "text": "The bottom line? I would heartily recommend this game to any Western Enthusiast or just anyone who would like to play some G.T.E. (Grand Theft Equus).",
