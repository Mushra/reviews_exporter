  {
    "id": "critic-cogconnected-18",
    "game": "red-dead-redemption-2",
    "review_type": "critic",
    "platform": "PC",
    "author": null,
    "publication": "COGconnected",
    "date": "2019-11-18",
    "score": 93,
    "text": "These are early days for the PC release and hopefully, the technical issues are addressed in the coming days. As things stand now, unless you have a top-notch PC, chances are you’re running a rig like mine and will have to make graphical compromises that leave you experiencing the game in a presentation fairly similar to that on the consoles. Regardless, this is unquestionably a brilliant experience. Everything about this version is bigger and better than the console version providing you have the rig to run it on.",
    "source": {
      "external_url": "https://cogconnected.com/review/red-dead-redemption-2-review-2/"
    },
    "metadata": {
      "product_id": 1400579386,
      "product_title": "Red Dead Redemption 2",
      "publication_slug": "cogconnected",
